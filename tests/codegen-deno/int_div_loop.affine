// SPDX-License-Identifier: MPL-2.0
// #478 regression: integer division inside a loop whose body ends in a
// tail-position `if` that reassigns the operands (a binary search). The
// block tail used to be generated before its statements, so the operands
// were forgotten as Int and `(lo + hi) / 2` became float division.

pub fn lower_bound(xs: [Int], x: Int) -> Int {
  let mut lo = 0;
  let mut hi = len(xs);
  while lo < hi {
    let mid = (lo + hi) / 2;
    if xs[mid] < x { lo = mid + 1; } else { hi = mid; }
  }
  lo
}

pub fn halves(n: Int) -> Int {
  let mut steps = 0;
  let mut k = n;
  for _x in [1, 2, 3, 4, 5, 6, 7, 8] {
    let half = k / 2;
    if half > 0 { k = half; steps = steps + 1; } else { k = 0; }
  }
  steps
}
