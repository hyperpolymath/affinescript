// SPDX-License-Identifier: MPL-2.0
// Regression: a local binding named like a host intrinsic (`get`, `len`,
// `trim`, `show`, ...) must shadow it. A parameter `get` used to compile to
// the ref-cell builtin, `("x").__cell`, and crash at run time (found while
// porting metadatastician/consent-aware-inspector).

use prelude::{ Option, Some, None };

pub fn call_param(get: String -> Option<String>) -> String {
  match get("x") { Some(v) => v, None => "none" }
}

// The initializer still calls the intrinsic; the body sees the local.
pub fn let_after_init(s: String) -> Int {
  let len = len(s);
  len + 1
}

pub fn lambda_param(s: String) -> String {
  let f = fn(trim: String -> String) => trim(s);
  f(fn(x: String) => x ++ "!")
}

// A binder's scope ends with its arm, loop or lambda: the intrinsic is
// visible again afterwards in the same function.
pub fn scope_ends(s: String, xs: [String -> String]) -> String {
  let mut out = "";
  for trim in xs { out = out ++ trim(s); }
  let h = match Some(fn(z: String) => "[" ++ z ++ "]") { Some(trim) => trim(s), None => "" };
  out ++ h ++ trim("  t  ")
}

pub fn let_scope_ends(s: String) -> String {
  let a = { let trim = fn(z: String) => z ++ "?"; trim(s) };
  a ++ trim("  u  ")
}
